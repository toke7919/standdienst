# Standdienst – Docker-Compose-Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an.
# cp .env.example .env

# PFLICHT: Mindestens 32 zufällige Zeichen
# Generieren: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# OPTIONAL: Datenbankpasswort (Standard: standdienst)
# In Produktion unbedingt ändern!
POSTGRES_PASSWORD=standdienst

# OPTIONAL: Öffentliche URL der Anwendung (für E-Mail-Links)
# In Produktion: https://deine-domain.de
FRONTEND_URL=http://localhost

# OPTIONAL: Port auf dem der Frontend-Container lauscht (Standard: 80)
FRONTEND_PORT=80

# OPTIONAL: true wenn FRONTEND_URL mit https:// beginnt
SESSION_COOKIE_SECURE=false

# OPTIONAL: Anzahl Gunicorn-Worker im API-Container (Standard: CPU*2+1)
# Für Docker-Deployments empfohlen: 2–4
GUNICORN_WORKERS=2
