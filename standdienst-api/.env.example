# --- Pflichtfelder ---
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret
DATABASE_URL=postgresql://user:password@localhost:5432/standdienst_v2
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SecurePassword1!

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=0

# --- Rate-Limiting ---
RATELIMIT_STORAGE_URI=memory://

# --- E-Mail (optional, alternativ per DB-Einstellungen) ---
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- Uploads ---
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=5

# --- Logging ---
FAIL2BAN_LOG=logs/auth.log

# --- Gunicorn ---
GUNICORN_WORKERS=
GUNICORN_BIND=0.0.0.0:8420

# --- Session-Cookie-Sicherheit ---
SESSION_COOKIE_SECURE=false
